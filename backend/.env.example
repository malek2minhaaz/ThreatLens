# ============================================================================
# ThreatShield - Environment Configuration
# Copy this file to `.env` and fill in your values.
# ============================================================================

# --- Core ---------------------------------------------------------------
# SQLite connection string (default). For Postgres, use:
#   postgresql+psycopg2://user:password@localhost:5432/threatshield
DATABASE_URL=sqlite:///./threatshield.db

# Host/port for the local server
HOST=0.0.0.0
PORT=8000

# --- Threat Intelligence API Keys (all OPTIONAL) -------------------------
# The scanner runs fully without these; providers are skipped gracefully
# when a key is missing. Get keys at:
#   VirusTotal          -> https://www.virustotal.com/gui/join-us
#   Google Safe Browsing-> https://developers.google.com/safe-browsing/v4/get-started
#   PhishTank           -> https://www.phishtank.com/api_register.php
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=

# --- Tuning --------------------------------------------------------------
# HTTP request timeout (seconds) for outbound metadata checks
REQUEST_TIMEOUT=10
