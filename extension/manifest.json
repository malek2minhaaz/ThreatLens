{
  "manifest_version": 3,
  "name": "ThreatLens Scanner",
  "version": "1.0.0",
  "description": "Scan any URL against your ThreatLens threat-detection backend: unified 0-100 risk score, heuristics, WHOIS/SSL/HTTP metadata and threat-intel verdicts.",
  "permissions": ["activeTab", "storage", "contextMenus", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with ThreatLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
